<ResourceDictionary
    x:Class="NINA.Plugin.SeeDark.Resources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.Plugin.SeeDark"
    xmlns:seq="clr-namespace:NINA.Plugin.SeeDark.Sequencer"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">

    <!-- Crescent moon icon -->
    <GeometryGroup x:Key="SeeDark_Icon" FillRule="Nonzero">
        <PathGeometry Figures="M12,2 C9.5,2 7.3,3.2 6,5 C8,5 10,6.5 10,9 C10,11.5 8,13 6,13 C7.3,14.8 9.5,16 12,16 C16,16 19,13 19,9 C19,5 16,2 12,2 Z"/>
    </GeometryGroup>

    <!-- SeeDarkContainer DataTemplate — DataType only, NO x:Key (implicit lookup by type) -->
    <DataTemplate DataType="{x:Type seq:SeeDarkContainer}">
        <nina:SequenceContainerView ShowDetails="{Binding ShowManualChildren}">
            <nina:SequenceContainerView.SequenceContainerContent>
                <StackPanel Margin="0,6,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Exposure (s):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Text="{Binding TargetExposure, StringFormat={}{0:F0}, UpdateSourceTrigger=LostFocus}"
                                 KeyDown="CommitOnEnter_KeyDown"
                                 Width="50" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Gain:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Text="{Binding Gain, UpdateSourceTrigger=LostFocus}"
                                 KeyDown="CommitOnEnter_KeyDown"
                                 Width="50" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </StackPanel>
                </StackPanel>
            </nina:SequenceContainerView.SequenceContainerContent>
        </nina:SequenceContainerView>
    </DataTemplate>

    <!-- StackMasterDarksInstruction DataTemplate -->
    <DataTemplate DataType="{x:Type seq:StackMasterDarksInstruction}">
        <nina:SequenceBlockView/>
    </DataTemplate>

    <!-- Plugin options UI — key must match AssemblyTitle + "_Options" -->
    <DataTemplate x:Key="SeeDark_Options" DataType="{x:Type local:SeeDarkPlugin}">
        <StackPanel Margin="8">

            <TextBlock Text="Folders" FontWeight="Bold" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Master dark library folder:" VerticalAlignment="Center" Margin="0,0,8,4"
                           ToolTip="Where finished master darks are stored. Used by both the gap check and the stacker."/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MasterLibraryFolder, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,4"
                         ToolTip="Where finished master darks are stored. Used by both the gap check and the stacker."/>
                <Button Grid.Row="0" Grid.Column="2" Content="..." Width="28" Margin="8,0,0,4" VerticalAlignment="Center" Click="BrowseMasterLibraryFolder_Click"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Raw darks folder:" VerticalAlignment="Center" Margin="0,0,8,4"
                           ToolTip="Raw darks folder is required. SeeDark writes DARK captures here and reads raws from here."/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RawDarksFolder, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,4"
                         ToolTip="Raw darks folder is required. SeeDark writes DARK captures here and reads raws from here."/>
                <Button Grid.Row="1" Grid.Column="2" Content="..." Width="28" Margin="8,0,0,4" VerticalAlignment="Center" Click="BrowseRawDarksFolder_Click"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="Raw darks folder is required. SeeDark writes DARK captures here and reads raws from here."
                           Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
            </Grid>

            <TextBlock Text="Dark Matching" FontWeight="Bold" Margin="0,16,0,6"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Default exposure (s):" VerticalAlignment="Center" Margin="0,0,8,4"
                           ToolTip="Overridable per container."/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TargetExposure, StringFormat={}{0:F0}, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" Margin="0,0,0,4"
                         KeyDown="CommitOnEnter_KeyDown"
                         ToolTip="Overridable per container."/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Default gain:" VerticalAlignment="Center" Margin="0,0,8,4"
                           ToolTip="e.g. S30 = 200. Overridable per container."/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Gain, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" Margin="0,0,0,4"
                         KeyDown="CommitOnEnter_KeyDown"
                         ToolTip="e.g. S30 = 200. Overridable per container."/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Temp bucket size (°C):" VerticalAlignment="Center" Margin="0,0,8,4"
                           ToolTip="One master dark for every 2 or 3 degrees."/>
                <ComboBox Grid.Row="2" Grid.Column="1" SelectedValue="{Binding TempBucketSize}"
                          SelectedValuePath="Content" VerticalAlignment="Center" Margin="0,0,0,4"
                          ToolTip="One master dark for every 2 or 3 degrees.">
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                </ComboBox>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Max master age (days):" VerticalAlignment="Center" Margin="0,0,8,0"
                           ToolTip="Days before a master should be replaceable."/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaxAgeDays, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                         ToolTip="Days before a master should be replaceable."/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Warmer bucket steps:" VerticalAlignment="Center" Margin="0,4,8,4"
                           ToolTip="Allow additional darks for the next Master Dark temp range up if temp rises during capture."/>
                <ComboBox Grid.Row="4" Grid.Column="1" SelectedValue="{Binding AutoDarkMaxWarmerBucketSteps}"
                          SelectedValuePath="Content" VerticalAlignment="Center" Margin="0,4,0,4"
                          ToolTip="Allow additional darks for the next Master Dark temp range up if temp rises during capture.">
                    <ComboBoxItem Content="0"/>
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                </ComboBox>

                <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="SeeDark Dark Manager aims for 30 accepted frames at your default exposure (≤30 capture attempts per temperature segment). Allowing warmer continuation adds roughly another segment per band — often about twice as long when moving one band warmer."
                           Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Manage lifecycle:" VerticalAlignment="Center" Margin="0,4,8,0"
                           ToolTip="Archive used raws after stacking and allow archive-based recovery rebuilds."/>
                <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding EnableLifecycleManagement, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,4,0,0"
                          ToolTip="Archive used raws after stacking and allow archive-based recovery rebuilds."/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Delete archive raws:" VerticalAlignment="Center" Margin="0,4,8,0"
                           ToolTip="Delete archived raws older than Max master age. Advanced — irreversible."/>
                <CheckBox Grid.Row="7" Grid.Column="1" IsChecked="{Binding DeleteArchivedRawsAfterMaxAge, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding EnableLifecycleManagement}" VerticalAlignment="Center" Margin="0,4,0,0"
                          ToolTip="Delete archived raws older than Max master age. Advanced — irreversible."/>

            </Grid>

            <TextBlock Text="Tip: Use a dedicated master dark library folder for SeeDark if you want to keep pre-plugin masters untouched."
                       Foreground="#888" FontSize="11" Margin="0,4,0,0"/>

            <TextBlock Text="Dark Stacker" FontWeight="Bold" Margin="0,16,0,6"/>
            <DockPanel Margin="0,4,0,4" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Additional NINA masters:" Width="180" VerticalAlignment="Center" Margin="0,0,8,0"
                           ToolTip="Also write a NINA-format master (16-bit + BZERO) e.g. for Livestack. SIRIL/PixInsight float32 master is always written."/>
                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding WriteNinaLiveMasters, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                          ToolTip="Also write a NINA-format master (16-bit + BZERO) e.g. for Livestack. SIRIL/PixInsight float32 master is always written."/>
            </DockPanel>

            <TextBlock Text="Notifications" FontWeight="Bold" Margin="0,16,0,6"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Discord webhook URL:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding DiscordWebhookUrl, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Verbose per-frame lines:" VerticalAlignment="Center" Margin="0,4,8,4"
                           ToolTip="Also send each per-frame auto dark line to Discord. Other log lines still mirror when a webhook URL is set. Very chatty; a dedicated channel is recommended."/>
                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding DiscordVerbosePerFrame, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,4,0,6"
                          ToolTip="Also send each per-frame auto dark line to Discord. Other log lines still mirror when a webhook URL is set. Very chatty; a dedicated channel is recommended."/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Scope name:" VerticalAlignment="Center" Margin="0,0,8,0"
                           ToolTip="If set, prepended to all Discord notifications as 'Name - message'. Sensor temp notifications already include scope model and serial (e.g. S30_5b948371)."/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DiscordScopeName, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                         ToolTip="If set, prepended to all Discord notifications as 'Name - message'. Sensor temp notifications already include scope model and serial (e.g. S30_5b948371)."/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Optional" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"/>
            </Grid>

        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
