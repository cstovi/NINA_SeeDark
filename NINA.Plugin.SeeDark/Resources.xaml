<ResourceDictionary
    x:Class="NINA.Plugin.SeeDark.Resources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.Plugin.SeeDark"
    xmlns:seq="clr-namespace:NINA.Plugin.SeeDark.Sequencer"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">

    <!-- Crescent moon icon -->
    <GeometryGroup x:Key="SeeDark_Icon" FillRule="Nonzero">
        <PathGeometry Figures="M12,2 C9.5,2 7.3,3.2 6,5 C8,5 10,6.5 10,9 C10,11.5 8,13 6,13 C7.3,14.8 9.5,16 12,16 C16,16 19,13 19,9 C19,5 16,2 12,2 Z"/>
    </GeometryGroup>

    <!-- SeeDarkContainer DataTemplate — DataType only, NO x:Key (implicit lookup by type) -->
    <DataTemplate DataType="{x:Type seq:SeeDarkContainer}">
        <nina:SequenceContainerView/>
    </DataTemplate>

    <!-- Plugin options UI — key must match AssemblyTitle + "_Options" -->
    <DataTemplate x:Key="SeeDark_Options" DataType="{x:Type local:SeeDarkPlugin}">
        <StackPanel Margin="8" MaxWidth="520">

            <TextBlock Text="Dark Library" FontWeight="Bold" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="DarkLibrary.csv path:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding DarkLibraryCsvPath, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Text="Dark Matching" FontWeight="Bold" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Target exposure (s):" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TargetExposure, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="e.g. 60" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,4" FontSize="11"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Max master age (days):" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaxAgeDays, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="default 180 (6 months)" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,4" FontSize="11"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Alpaca port (fallback):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AlpacaPort, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="default 11111" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"/>
            </Grid>

            <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Padding="12,4" Margin="0,12,0,0"/>

        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
