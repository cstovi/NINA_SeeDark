<ResourceDictionary
    x:Class="NINA.Plugin.SeeDark.Resources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.Plugin.SeeDark"
    xmlns:seq="clr-namespace:NINA.Plugin.SeeDark.Sequencer"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">

    <!-- Crescent moon icon -->
    <GeometryGroup x:Key="SeeDark_Icon" FillRule="Nonzero">
        <PathGeometry Figures="M12,2 C9.5,2 7.3,3.2 6,5 C8,5 10,6.5 10,9 C10,11.5 8,13 6,13 C7.3,14.8 9.5,16 12,16 C16,16 19,13 19,9 C19,5 16,2 12,2 Z"/>
    </GeometryGroup>

    <!-- SeeDarkContainer DataTemplate — DataType only, NO x:Key (implicit lookup by type) -->
    <DataTemplate DataType="{x:Type seq:SeeDarkContainer}">
        <nina:SequenceContainerView ShowDetails="{Binding ShowManualChildren}">
            <nina:SequenceContainerView.SequenceContainerContent>
                <StackPanel Margin="0,6,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Exposure (s):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Text="{Binding TargetExposure, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged, FallbackValue=20, TargetNullValue=20}"
                                 Width="50" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Gain:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Text="{Binding Gain, UpdateSourceTrigger=PropertyChanged, FallbackValue=200, TargetNullValue=200}"
                                 Width="50" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </StackPanel>
                </StackPanel>
            </nina:SequenceContainerView.SequenceContainerContent>
        </nina:SequenceContainerView>
    </DataTemplate>

    <!-- StackMasterDarksInstruction DataTemplate -->
    <DataTemplate DataType="{x:Type seq:StackMasterDarksInstruction}">
        <nina:SequenceBlockView/>
    </DataTemplate>

    <!-- Plugin options UI — key must match AssemblyTitle + "_Options" -->
    <DataTemplate x:Key="SeeDark_Options" DataType="{x:Type local:SeeDarkPlugin}">
        <StackPanel Margin="8">

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Master dark library folder:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding MasterLibraryFolder, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="..." Width="28" Margin="8,0,0,0" VerticalAlignment="Center" Click="BrowseMasterLibraryFolder_Click"/>
            </Grid>

            <TextBlock Text="Dark Matching" FontWeight="Bold" Margin="0,16,0,6"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Default exposure (s):" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TargetExposure, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="overridable per container" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,4" FontSize="11"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Default gain:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Gain, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="e.g. S30 = 200 · overridable per container" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,4" FontSize="11"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Temp bucket size (°C):" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <ComboBox Grid.Row="2" Grid.Column="1" SelectedValue="{Binding TempBucketSize}"
                          SelectedValuePath="Content" VerticalAlignment="Center" Margin="0,0,0,4">
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                </ComboBox>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="One master dark for every 2 or 3 degrees."
                           Foreground="#888" VerticalAlignment="Top" Margin="8,0,0,4" FontSize="11" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Max master age (days):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaxAgeDays, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="Days before a master should be replaceable."
                           Foreground="#888" VerticalAlignment="Top" Margin="8,0,0,0" FontSize="11" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Warmer bucket steps:" VerticalAlignment="Center" Margin="0,4,8,4"/>
                <ComboBox Grid.Row="4" Grid.Column="1" SelectedValue="{Binding AutoDarkMaxWarmerBucketSteps}"
                          SelectedValuePath="Content" VerticalAlignment="Center" Margin="0,4,0,4">
                    <ComboBoxItem Content="0"/>
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                </ComboBox>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="Allow additional darks for next Master Dark temp range up if temp rises during capture."
                           Foreground="#888" VerticalAlignment="Top" Margin="8,4,0,4" FontSize="11" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="SeeDark Dark Manager aims for 30 accepted frames at your default exposure (≤30 capture attempts per temperature segment). Allowing warmer continuation adds roughly another segment per band — often about twice as long when moving one band warmer."
                           Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding EnableLifecycleManagement, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="6" Grid.Column="2" Text="Enable lifecycle management: archive used raws and allow archive-based rebuilds."
                           Foreground="#888" VerticalAlignment="Top" Margin="8,4,0,0" FontSize="11" TextWrapping="Wrap"/>

                <CheckBox Grid.Row="7" Grid.Column="1" IsChecked="{Binding DeleteArchivedRawsAfterMaxAge, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding EnableLifecycleManagement}" VerticalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="7" Grid.Column="2" Text="Delete archived raws older than Max master age (advanced, irreversible)."
                           Foreground="#888" VerticalAlignment="Top" Margin="8,4,0,0" FontSize="11" TextWrapping="Wrap"/>

            </Grid>

            <TextBlock Text="Tip: Use a dedicated master dark library folder for SeeDark if you want to keep pre-plugin masters untouched."
                       Foreground="#888" FontSize="11" Margin="0,4,0,0"/>

            <TextBlock Text="Dark Stacker" FontWeight="Bold" Margin="0,16,0,6"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Raw darks folder:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Column="1" Text="{Binding RawDarksFolder, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                <Button Grid.Column="2" Content="..." Width="28" Margin="8,0,0,4" VerticalAlignment="Center" Click="BrowseRawDarksFolder_Click"/>
            </Grid>
            <DockPanel Margin="0,4,0,4" LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="Additional NINA masters:" Width="180" VerticalAlignment="Top" Margin="0,2,8,0"/>
                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding WriteNinaLiveMasters, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                <TextBlock Text="Also write a NINA-format master (16-bit + BZERO). SIRIL/PixInsight float32 master is always written."
                           TextWrapping="Wrap" Foreground="#888" FontSize="11" VerticalAlignment="Top"/>
            </DockPanel>

            <TextBlock Text="Notifications" FontWeight="Bold" Margin="0,16,0,6"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Discord webhook URL:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding DiscordWebhookUrl, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Verbose per-frame lines:" VerticalAlignment="Center" Margin="0,4,8,4"/>
                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding DiscordVerbosePerFrame, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Optional: also send each per-frame auto dark line to Discord. Other log lines still mirror when a webhook URL is set. Very chatty; a dedicated channel is recommended."
                           Foreground="#888" VerticalAlignment="Top" Margin="8,4,0,4" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Scope name:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DiscordScopeName, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Optional. If set, prepended to all Discord notifications as &quot;Name - message&quot;. Sensor temp notifications already include scope model and serial (e.g. S30_5b948371)."
                           Foreground="#888" VerticalAlignment="Top" Margin="8,4,0,0" FontSize="11" TextWrapping="Wrap"/>
            </Grid>

        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
