<ResourceDictionary
    x:Class="NINA.Plugin.SeeDark.Resources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.Plugin.SeeDark"
    xmlns:seq="clr-namespace:NINA.Plugin.SeeDark.Sequencer"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">

    <!-- Crescent moon icon -->
    <GeometryGroup x:Key="SeeDark_Icon" FillRule="Nonzero">
        <PathGeometry Figures="M12,2 C9.5,2 7.3,3.2 6,5 C8,5 10,6.5 10,9 C10,11.5 8,13 6,13 C7.3,14.8 9.5,16 12,16 C16,16 19,13 19,9 C19,5 16,2 12,2 Z"/>
    </GeometryGroup>

    <!-- SeeDarkContainer DataTemplate — DataType only, NO x:Key (implicit lookup by type) -->
    <DataTemplate DataType="{x:Type seq:SeeDarkContainer}">
        <nina:SequenceContainerView ShowDetails="{Binding ShowManualChildren}">
            <nina:SequenceContainerView.SequenceContainerContent>
                <StackPanel Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Exposure (s):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Text="{Binding TargetExposure, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged, FallbackValue=20, TargetNullValue=20}"
                                 Width="50" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Gain:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Text="{Binding Gain, UpdateSourceTrigger=PropertyChanged, FallbackValue=200, TargetNullValue=200}"
                                 Width="50" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox SelectedValue="{Binding ExecutionMode}" SelectedValuePath="Tag" Width="90" VerticalAlignment="Center">
                            <ComboBoxItem Content="Manual" Tag="{x:Static seq:DarkExecutionMode.Manual}"/>
                            <ComboBoxItem Content="Auto" Tag="{x:Static seq:DarkExecutionMode.Auto}"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Text="Hint: These check values must match the dark capture settings in child instructions."
                               Foreground="#888" FontSize="11" Margin="0,6,0,0"/>
                    <TextBlock Text="Auto mode runs internal dark capture and ignores child instructions."
                               Foreground="#d08c00" FontSize="11" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowManualChildren}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </nina:SequenceContainerView.SequenceContainerContent>
        </nina:SequenceContainerView>
    </DataTemplate>

    <!-- StackMasterDarksInstruction DataTemplate -->
    <DataTemplate DataType="{x:Type seq:StackMasterDarksInstruction}">
        <nina:SequenceBlockView/>
    </DataTemplate>

    <!-- Plugin options UI — key must match AssemblyTitle + "_Options" -->
    <DataTemplate x:Key="SeeDark_Options" DataType="{x:Type local:SeeDarkPlugin}">
        <StackPanel Margin="8">

            <TextBlock Text="Library" FontWeight="Bold" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Master library folder:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding MasterLibraryFolder, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Text="Dark Matching" FontWeight="Bold" Margin="0,16,0,6"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Default exposure (s):" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TargetExposure, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="seeds new containers" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,4" FontSize="11"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Default gain:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Gain, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="seeds new containers (S30 = 200)" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,4" FontSize="11"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Temp bucket size (°C):" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <ComboBox Grid.Row="2" Grid.Column="1" SelectedValue="{Binding TempBucketSize}"
                          SelectedValuePath="Content" VerticalAlignment="Center" Margin="0,0,0,4">
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                </ComboBox>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="choose 2°C or 3°C non-overlapping bucket bands for matching and stacking" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,4" FontSize="11"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Max master age (days):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaxAgeDays, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="default 180 (6 months)" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Default mode (new containers):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Row="4" Grid.Column="1" SelectedValue="{Binding DefaultExecutionMode}"
                          SelectedValuePath="Tag" VerticalAlignment="Center">
                    <ComboBoxItem Content="Auto" Tag="{x:Static seq:DarkExecutionMode.Auto}"/>
                    <ComboBoxItem Content="Manual" Tag="{x:Static seq:DarkExecutionMode.Manual}"/>
                </ComboBox>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="Auto: container captures darks internally. Manual: container runs child instructions. Applies to new containers." Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"/>

                <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding EnableLifecycleManagement, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="5" Grid.Column="2" Text="Enable lifecycle management (archive used raw darks and allow archive-based rebuilds)." Foreground="#888" VerticalAlignment="Center" Margin="8,4,0,0" FontSize="11"/>

                <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding DeleteArchivedRawsAfterMaxAge, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding EnableLifecycleManagement}" VerticalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="6" Grid.Column="2" Text="Delete archived raw darks older than Max master age (advanced; irreversible)." Foreground="#888" VerticalAlignment="Center" Margin="8,4,0,0" FontSize="11"/>

            </Grid>

            <TextBlock Text="Tip: Use a dedicated master library folder for SeeDark if you want to keep pre-plugin masters untouched."
                       Foreground="#888" FontSize="11" Margin="0,4,0,0"/>

            <TextBlock Text="Dark Stacker" FontWeight="Bold" Margin="0,16,0,6"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Raw darks folder:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RawDarksFolder, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,4"/>
            </Grid>

            <TextBlock Text="Notifications" FontWeight="Bold" Margin="0,16,0,6"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Discord webhook URL:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding DiscordWebhookUrl, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
            </Grid>

        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
